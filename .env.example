# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Open-Weight Model Inference Configuration (Optional - Game includes 60+ offline quests fallback)
# Add HF_API_KEY in Vercel -> Project Settings -> Environment Variables
HF_API_KEY=""

# Or configure any OpenAI-compatible Open-Weight inference endpoint (Groq, Together, Fireworks, Ollama, etc.)
OPEN_MODEL_BASE_URL="https://router.huggingface.co/v1"
OPEN_MODEL_NAME="meta-llama/Llama-3.2-3B-Instruct"
OPEN_MODEL_API_KEY=""

